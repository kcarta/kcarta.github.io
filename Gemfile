source "https://rubygems.org"

gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-paginate", "~> 1.1"
  gem "jekyll-gist", "~> 1.5"
end

# WEBrick is no longer bundled with Ruby 3+
gem "webrick", "~> 1.8"

# These libraries were promoted out of the standard library in newer Rubies
# and are required transitively by Jekyll / its dependencies.
gem "csv"
gem "base64"
gem "logger"
